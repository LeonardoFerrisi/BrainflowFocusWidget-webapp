{
  "name": "leonardo-telepathy-software",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Leonardo Telepathy Software - EEG focus/relaxation measurement for any BrainFlow board",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build && npm run typecheck:server",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist-electron/server/index.mjs --external:brainflow --external:koffi --external:serialport --external:express --external:ws",
    "build:worker": "esbuild server/board-worker.ts --bundle --platform=node --format=cjs --outfile=dist-electron/server/board-worker.cjs --external:brainflow --external:koffi",
    "build:electron-main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:electron",
    "build:desktop": "npm run build && npm run build:server && npm run build:worker && npm run build:electron-main",
    "electron:dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\" \"npm run build:electron-main && wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron dist-electron/main.cjs\"",
    "electron:build": "npm run build:desktop && electron-builder --win"
  },
  "dependencies": {
    "brainflow": "^5.19.0",
    "express": "^4.21.2",
    "serialport": "^12.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "wait-on": "^8.0.5"
  }
}
